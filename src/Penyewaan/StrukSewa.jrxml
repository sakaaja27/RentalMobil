	<queryString>
		<![CDATA[SELECT *, SUBSTRING(DATE_FORMAT(v_struk.tgl_sewa, '%Y-%m-%d'), 1, 10) AS tgl_sewa_substring, (v_struk.bayar - v_struk.total_harga) AS kembalian FROM v_struk WHERE kd_penyewaan = $P{kd_penyewaan};]]>
	</queryString>
